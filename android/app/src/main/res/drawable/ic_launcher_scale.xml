<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground: the scales of justice, matching the amber-on-slate
    mark used on the login screen (the lucide "Scale" glyph).

    Adaptive icons are 108x108dp with only the middle 72x72dp guaranteed
    visible - the outer 18dp on each side is reserved for the launcher's mask
    and parallax. The artwork below is therefore drawn inside roughly the
    central 60x60dp so it never gets clipped into a circle, squircle or squircle
    -with-rounded-corners depending on the launcher.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Central column -->
    <path
        android:fillColor="#FBBF24"
        android:pathData="M52.2,30h3.6v44h-3.6z" />

    <!-- Base foot -->
