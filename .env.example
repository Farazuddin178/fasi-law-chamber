# Supabase Configuration - Get from https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─────────────────────────────────────────────────
# Backend (Python / Flask on Render)
# ─────────────────────────────────────────────────
# REQUIRED for Capacitor mobile: must be an absolute HTTPS URL.
# On web (browser), leaving this blank uses same-origin relative paths.
VITE_BACKEND_URL=https://your-app-name.onrender.com

# ─────────────────────────────────────────────────
# Backend (Python / Flask) — these have no VITE_ prefix, so Vite never
# bundles them into the frontend. Set them as real environment variables in
# Render's dashboard for production; a local .env is only read by proxy.py
# itself via python-dotenv, never shipped to the browser or the app.
# ─────────────────────────────────────────────────
# Chamber AI (ai_routes.py) — https://aistudio.google.com/apikey
# Never commit a real key here or anywhere else in the repo.
GEMINI_API_KEY=
# Optional: override the model without a redeploy. See CONTEXT.md §5d for
# why this needs to stay current — Gemini model names get retired.
GEMINI_MODEL=gemini-3.6-flash

# ─────────────────────────────────────────────────
# Firebase (optional — only if using Firebase push on web)
# ─────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
