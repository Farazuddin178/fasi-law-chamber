store-dir=/tmp/.pnpm-store
virtual-store-dir=/tmp/legal-case-management/.pnpm
frozen-lockfile=false
legacy-peer-deps=true
# NOTE: do NOT set ignore-scripts=true here. It blocks every build script,
# including the packages explicitly approved in pnpm-workspace.yaml's
# onlyBuiltDependencies, which makes pnpm 10 fail with ERR_PNPM_IGNORED_BUILDS.
# onlyBuiltDependencies is the allowlist that controls this instead.

# Disable pnpm's supply-chain minimum-release-age policy.
# Without this, any package published < 24 h before a build causes ERR_PNPM_MINIMUM_RELEASE_AGE_VIOLATION.
minimum-release-age=0
# Never let an unapproved-but-scripted dependency turn into a hard build failure.
strict-dep-builds=false
